# 真实值仅存服务器侧 .env，不入 git（占位符模板）
APP_SECRET_KEY=<随机64位hex>
ADMIN_USER=admin
ADMIN_PASS=<管理员密码>

MONGO_URI=mongodb://jingguan:<密码>@127.0.0.1:27018/?authSource=jingguan
MONGO_DB=jingguan

VOICE_API_KEY=<火山TTS API Key（控制台>API Key管理，配合 v3 接口 X-Api-Resource-Id 使用）>

ASR_API_KEY=<豆包语音识别2.0 API Key（新版控制台 API Key 管理，双向流式 X-Api-Key 鉴权，模型 volc.seedasr.sauc.duration）>

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=<DeepSeek API Key>
LLM_MODEL=deepseek-v4-flash

# 启用 HTTPS 后设 true（登录 Cookie 加 Secure 标志）
COOKIE_SECURE=false
